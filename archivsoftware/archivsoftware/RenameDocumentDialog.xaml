<Window x:Class="archivsoftware.RenameDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokument umbenennen" 
        Height="326" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Dokument umbenennen"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#E0E0E0"
                   Margin="0,0,0,15"/>

        <!-- Aktueller Name Label -->
        <TextBlock Grid.Row="1"
                   Text="Aktueller Name:"
                   FontSize="13"
                   Foreground="#909090"
                   Margin="0,0,0,5"/>

        <!-- Aktueller Name Wert -->
        <TextBlock x:Name="CurrentNameText"
                   Grid.Row="2"
                   Text=""
                   FontSize="14"
                   Foreground="#D0D0D0"
                   Margin="0,0,0,20"/>

        <!-- Neuer Name Eingabe -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="Neuer Name:"
                       FontSize="13"
                       Foreground="#909090"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="NewNameTextBox"
                     Height="58"
                     Padding="12,0"
                     FontSize="14"
                     Background="#0D0D0D"
                     Foreground="#E0E0E0"
                     BorderBrush="#404040"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Hinweis: Dateiendung (.pdf/.docx) wird automatisch beibehalten"
                       FontSize="11"
                       Foreground="#606060"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="CancelButton"
                    Content="Abbrechen"
                    Width="100"
                    Height="38"
                    Background="#0D0D0D"
                    Foreground="#E0E0E0"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Umbenennen"
                    Width="120"
                    Height="38"
                    Background="#0D6EFD"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>