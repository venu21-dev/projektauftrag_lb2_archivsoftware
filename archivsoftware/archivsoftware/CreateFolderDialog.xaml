<Window x:Class="archivsoftware.CreateFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuer Ordner" 
        Height="269" 
        Width="430"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Neuen Ordner erstellen"
                   Foreground="#E0E0E0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Label -->
        <TextBlock Grid.Row="1"
                   Text="Ordnername:"
                   Foreground="#A0A0A0"
                   FontSize="13"
                   Margin="0,0,0,8"/>

        <!-- TextBox für Ordnername -->
        <Border Grid.Row="2"
                Background="#0D0D0D"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                VerticalAlignment="Top"
                Height="58">
            <TextBox x:Name="FolderNameTextBox"
                     Background="Transparent"
                     Foreground="#E0E0E0"
                     BorderThickness="0"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <!-- Abbrechen Button -->
            <Button Content="Abbrechen"
                    Width="100"
                    Height="35"
                    Background="#0D0D0D"
                    Foreground="#E0E0E0"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Erstellen Button -->
            <Button Content="Erstellen"
                    Width="100"
                    Height="35"
                    Background="#0D6EFD"
                    Foreground="#FFFFFF"
                    BorderBrush="#0D6EFD"
                    BorderThickness="1"
                    Click="CreateButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0B5ED7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>